<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sky_widget"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/sky_widget_frame"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/sky_widget_sky"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/sky_widget_empty" />

    <ImageView
        android:id="@+id/sky_widget_stars"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="6dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="6dp"
        android:layout_marginBottom="30dp"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        android:visibility="gone" />

    <TextView
        android:id="@+id/sky_widget_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="10dp"
        android:fontFamily="serif"
        android:maxLines="1"
        android:text="@string/sky_widget_empty"
        android:textColor="@color/sky_widget_night_text"
        android:textSize="16sp"
        android:textStyle="italic" />
</FrameLayout>
